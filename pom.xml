<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.snowgears.shop</groupId>
    <artifactId>shop-parent</artifactId>
    <name>Shop</name>
    <packaging>pom</packaging>
    <version>${revision}</version>

    <properties>
        <revision>1.10.1</revision>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <profiles>
        <profile>
            <id>modern</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
    <modules>
        <module>core</module>
        <module>dist</module>
        <module>nms/v1_20_R4</module>
        <module>nms/v1_20_R3</module>
        <module>nms/v1_20_R2</module>
        <!-- <module>v1_20_R1</module> -->
        <module>nms/v1_19_R3</module>
        <module>nms/v1_19_R2</module>
        <module>nms/v1_19_R1</module>
        <module>nms/v1_18_R2</module>
        <module>nms/v1_18_R1</module>
        <module>nms/v1_17_R1</module>
        <module>nms/v1_16_R3</module>
        <module>nms/v1_16_R2</module>
        <module>nms/v1_16_R1</module>
        <module>nms/v1_15_R1</module>
        <module>nms/v1_14_R1</module>
        <!-- <module>nms/v1_13_R2</module> disabled until we rebuild the docker image with 1.13 but it takes like an hour to build
        <module>nms/v1_13_R1</module> -->
        <module>nms/v1_12_R1</module>
        <module>nms/v1_11_R1</module>
        <module>nms/v1_10_R1</module>
        <module>nms/v1_9_R2</module>
        <module>nms/v1_8_R3</module>
    </modules>
            <properties>
                <maven.compiler.source>8</maven.compiler.source>
                <maven.compiler.target>8</maven.compiler.target>
                <build.suffix></build.suffix>
                <!-- Modern dependency versions (Java 17) -->
                <spigot.version>1.21-R0.1-SNAPSHOT</spigot.version>
                <hikaricp.version>5.0.1</hikaricp.version>
                <h2.version>2.1.214</h2.version>
                <junit.version>5.11.0</junit.version>
                <mariadb.version>2.7.5</mariadb.version>
                <nbt-api.version>2.14.1</nbt-api.version>
                <jetbrains-annotations.version>24.0.1</jetbrains-annotations.version>
                <bluemap.version>2.7.2</bluemap.version>
            </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
        </profile>

        <profile>
            <id>legacy</id>
            <modules>
                <module>core</module>
                <module>dist</module>
                <!-- Only Java 8-compatible NMS versions (Minecraft 1.14-1.16) -->
                <module>nms/v1_16_R3</module>
                <module>nms/v1_16_R2</module>
                <module>nms/v1_16_R1</module>
                <module>nms/v1_15_R1</module>
                <module>nms/v1_14_R1</module>
            </modules>
    <properties>
                <maven.compiler.source>8</maven.compiler.source>
                <maven.compiler.target>8</maven.compiler.target>
                <build.suffix>-legacy</build.suffix>
                <!-- Java 8 compatible dependency versions -->
                <spigot.version>1.16.5-R0.1-SNAPSHOT</spigot.version>
                <hikaricp.version>3.4.5</hikaricp.version>
                <h2.version>1.4.200</h2.version>
                <junit.version>5.11.0</junit.version>
                <mariadb.version>2.7.5</mariadb.version>
                <nbt-api.version>2.12.4</nbt-api.version>
                <jetbrains-annotations.version>20.1.0</jetbrains-annotations.version>
                <plotsquared.version>6.11.0</plotsquared.version>
                <bluemap.version>2.3.0</bluemap.version>
    </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <version>3.8.1</version>
                        <configuration>
                            <source>8</source>
                            <target>8</target>
                            <compilerArgs>
                                <arg>-parameters</arg>
                            </compilerArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>local-m2-repo</id>
            <url>file://${project.basedir}/../SpigotBuildTools/maven/repository</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>local-m2-repo</id>
            <url>file://${project.basedir}/../SpigotBuildTools/maven/repository</url>
        </pluginRepository>
    </pluginRepositories>

</project>

